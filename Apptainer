Bootstrap: docker
From: ubuntu:26.04

%labels
    Maintainer Stefano Campanella
    Version 0.1
    Description Apptainer image for arco-make based on Ubuntu 26.04 (using uv).

%files
    pyproject.toml /app/pyproject.toml
    uv.lock /app/uv.lock
    src /app/src
    README.md /app/README.md
    LICENSE /app/LICENSE

%post
    export DEBIAN_FRONTEND=noninteractive
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        build-essential \
        cmake \
        gfortran \
        libaec-dev \
        libnetcdf-dev \
        libpng-dev \
        libopenjp2-7-dev

    # Build and install ecCodes from source
    ECCODES_VERSION=2.48.0
    cd /tmp
    curl -LsSf -o eccodes.tar.gz \
        "https://confluence.ecmwf.int/download/attachments/45757960/eccodes-${ECCODES_VERSION}-Source.tar.gz?api=v2"
    tar -xzf eccodes.tar.gz
    mkdir eccodes-build && cd eccodes-build
    cmake -DCMAKE_INSTALL_PREFIX=/usr/local \
          -DCMAKE_BUILD_TYPE=Release \
          -DENABLE_NETCDF=ON \
          -DENABLE_JPG=ON \
          -DENABLE_PNG=ON \
          -DENABLE_AEC=ON \
          -DENABLE_FORTRAN=ON \
          "../eccodes-${ECCODES_VERSION}-Source"
    make -j"$(nproc)"
    ctest -j"$(nproc)"
    make install
    ldconfig
    cd /tmp && rm -rf eccodes.tar.gz eccodes-build "eccodes-${ECCODES_VERSION}-Source"

    # Install uv by Astral
    curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin sh

    # Install the uv-managed Python outside of $HOME, so that Apptainer's
    # automatic bind-mount of the home directory cannot shadow the interpreter
    # the virtual environment symlinks to (see %environment below).
    export UV_PYTHON_INSTALL_DIR=/opt/uv/python

    # Create uv environment
    cd /app
    # The pyproject.toml specifies python >= 3.13
    uv python install 3.13
    uv sync --frozen

%environment
    # Add uv environment to PATH
    export PATH="/app/.venv/bin:$PATH"
    # Point uv at the interpreter installed under /opt during %post: /app/.venv
    # only holds symlinks to it, and a location under $HOME would be hidden by
    # Apptainer's default home bind-mount, forcing uv to re-create the
    # (read-only) virtual environment at runtime.
    export UV_PYTHON_INSTALL_DIR=/opt/uv/python
    # Everything inside the SIF is read-only, and $HOME may not be writable
    # either (e.g. HOME=/root with --no-home). Redirect uv's cache/lock
    # directory and the generic XDG cache to /tmp, which Apptainer always
    # provides as a writable location. Both can be overridden by the caller.
    export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/uv-cache}"
    export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/cache}"
    
%runscript
    cd /app
    mkdir -p "$UV_CACHE_DIR" "$XDG_CACHE_HOME"
    if [ $# -eq 0 ]; then
        /bin/bash
    else
        exec uv run --no-sync arco-make "$@"
    fi

%help
    This container provides an environment for running arco-make.

    USAGE EXAMPLE:

      apptainer run arco-make.sif download /absolute/path/to/config.toml /absolute/path/to/output.zip