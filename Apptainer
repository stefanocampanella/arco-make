Bootstrap: docker
From: ubuntu:26.04

%labels
    Maintainer Stefano Campanella
    Version 0.1
    Description Apptainer image for arco-make based on Ubuntu 26.04, using uv and Open MPI 4.1.6 (built from source with UCX and Slurm support).

%files
    pyproject.toml /app/pyproject.toml
    uv.lock /app/uv.lock
    src /app/src
    README.md /app/README.md
    LICENSE /app/LICENSE

%post
    export DEBIAN_FRONTEND=noninteractive
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        build-essential \
        cmake \
        gfortran \
        libaec-dev \
        libnetcdf-dev \
        libpng-dev \
        libopenjp2-7-dev \
        libucx-dev \
        libhwloc-dev

    # Build Open MPI from source with UCX (high-performance transports, e.g.
    # InfiniBand) and Slurm (launching via srun) support, pinning the version.
    OPENMPI_VERSION=4.1.6
    OPENMPI_SERIES=v4.1
    cd /tmp
    curl -LsSf -o openmpi.tar.gz \
        "https://download.open-mpi.org/release/open-mpi/${OPENMPI_SERIES}/openmpi-${OPENMPI_VERSION}.tar.gz"
    tar -xzf openmpi.tar.gz
    cd "openmpi-${OPENMPI_VERSION}"
    ./configure --prefix=/usr/local \
                --with-ucx \
                --with-slurm
    make -j"$(nproc)"
    make install
    # Register the install prefix so libmpi.so.* is found via the linker cache.
    echo "/usr/local/lib" > /etc/ld.so.conf.d/openmpi.conf
    ldconfig
    cd /tmp && rm -rf openmpi.tar.gz "openmpi-${OPENMPI_VERSION}"

    # Build and install ecCodes from source
    ECCODES_VERSION=2.48.0
    cd /tmp
    curl -LsSf -o eccodes.tar.gz \
        "https://confluence.ecmwf.int/download/attachments/45757960/eccodes-${ECCODES_VERSION}-Source.tar.gz?api=v2"
    tar -xzf eccodes.tar.gz
    mkdir eccodes-build && cd eccodes-build
    cmake -DCMAKE_INSTALL_PREFIX=/usr/local \
          -DCMAKE_BUILD_TYPE=Release \
          -DENABLE_NETCDF=ON \
          -DENABLE_JPG=ON \
          -DENABLE_PNG=ON \
          -DENABLE_AEC=ON \
          -DENABLE_FORTRAN=ON \
          "../eccodes-${ECCODES_VERSION}-Source"
    make -j"$(nproc)"
    ctest -j"$(nproc)"
    make install
    # Register the install prefix so libeccodes.so.* is found via the linker cache.
    echo "/usr/local/lib" > /etc/ld.so.conf.d/eccodes.conf
    ldconfig
    cd /tmp && rm -rf eccodes.tar.gz eccodes-build "eccodes-${ECCODES_VERSION}-Source"

    # Install uv by Astral
    curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin sh

    # Install the uv-managed Python outside $HOME so Apptainer's home
    # bind-mount cannot shadow the interpreter the venv symlinks to.
    export UV_PYTHON_INSTALL_DIR=/opt/uv/python

    # Create uv environment
    cd /app
    # The pyproject.toml specifies python >= 3.13
    uv python install 3.13
    uv sync --frozen

%environment
    # Add uv environment to PATH
    export PATH="/app/.venv/bin:$PATH"
    # Expose the in-image Open MPI 4.1.6 (see %post) so mpi4py finds libmpi.so.*
    # at runtime and the container works standalone.
    export LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH}"
    # On HPC you can instead use the host MPI (bind model), e.g.:
    #   mpirun -n <N> apptainer run \
    #       --bind /path/to/host/openmpi/lib:/opt/host-mpi/lib \
    #       --env LD_LIBRARY_PATH=/opt/host-mpi/lib:$LD_LIBRARY_PATH \
    #       arco-make.sif ...
    # (the host MPI must be ABI-compatible, i.e. also expose libmpi.so.40).
    # Point uv at the interpreter installed under /opt during %post; /app/.venv
    # only holds symlinks to it (a $HOME location would be hidden by the home
    # bind-mount, forcing uv to re-create the read-only venv at runtime).
    export UV_PYTHON_INSTALL_DIR=/opt/uv/python
    # The SIF is read-only and $HOME may not be writable (e.g. --no-home), so
    # redirect uv and XDG caches to the always-writable /tmp. Overridable.
    export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/uv-cache}"
    export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/cache}"
    
%runscript
    cd /app
    mkdir -p "$UV_CACHE_DIR" "$XDG_CACHE_HOME"
    if [ $# -eq 0 ]; then
        /bin/bash
    else
        exec uv run --no-sync arco-make "$@"
    fi

%help
    This container provides an environment for running arco-make.

    USAGE EXAMPLE:

      apptainer run arco-make.sif download /absolute/path/to/config.toml /absolute/path/to/output.zip